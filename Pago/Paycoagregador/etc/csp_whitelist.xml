<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="epayco-agregador-checkout" type="host">https://epayco-checkout-testing.s3.amazonaws.com</value>
                <value id="apify-agregador-ms" type="host">https://eks-apify-service.epayco.io</value>
                <value id="secure-epayco-agregador" type="host">https://eks-checkout-service.epayco.io</value>
                <value id="new-checkout-agregador" type="host">https://new-checkout.epayco.io</value>
            </values>
        </policy>

        <policy id="connect-src">
            <values>
                <value id="epayco-agregador-create-transaction" type="host">https://eks-ms-checkout-transaction-service.epayco.io</value>
                <value id="apify-private-epayco-agregador" type="host">https://eks-apify-private-service.epayco.io</value>
                <value id="epayco-agregador-checkout-testing" type="host">https://epayco-checkout-testing.s3.amazonaws.com</value>
                <value id="epayco-agregador-apify" type="host">https://eks-apify-service.epayco.io</value>
                <value id="eks-checkout-service-agregador" type="host">https://eks-checkout-service.epayco.io</value>
                <value id="new-checkout-secure-agregador" type="host">https://new-checkout.epayco.io</value>
            </values>
        </policy>

        <policy id="frame-src">
            <values>
                <value id="new-checkout-frame-agregador" type="host">https://new-checkout.epayco.io</value>
            </values>
        </policy>

    </policies>
</csp_whitelist>
